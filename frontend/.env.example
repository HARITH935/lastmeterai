# Frontend environment variables (Vite).
# Copy to .env.local for local dev; set the same keys in Vercel for production.

# Base URL of the Flask backend API. No trailing slash.
# Local:      http://localhost:5001
# Production: https://lastmeterai.onrender.com
VITE_API_BASE=http://localhost:5001

# Mapbox public access token (pk.…). REQUIRED — maps won't render without it.
# Get one at https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=

# OpenWeatherMap API key for the map weather overlay. Optional —
# the code falls back to a shared key if unset.
VITE_OWM_KEY=

# Power BI "Publish to web" embed URL for the /power-bi page. Optional —
# the page shows a setup guide until this is set.
VITE_POWERBI_EMBED_URL=
