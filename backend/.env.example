# ── Flask ─────────────────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_APP=run.py

# NEVER commit real values — copy this file to .env and fill in secrets.

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=replace-with-64-char-random-string
JWT_SECRET_KEY=replace-with-different-64-char-random-string

# ── Database ──────────────────────────────────────────────────────────────────
# Development (SQLite — local file)
DATABASE_URL=sqlite:///lastmeter_dev.db
# Production (PostgreSQL on Render/Railway — uncomment and fill in)
# DATABASE_URL=postgresql://user:password@host:5432/lastmeter_prod

# ── External APIs ─────────────────────────────────────────────────────────────
OPENWEATHER_API_KEY=your_openweather_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
TOMTOM_API_KEY=your_tomtom_api_key_here
# Free tier allows only 20 generate requests/day for gemini-2.5-flash, shared
# by chat and RAG answers. Past the cap both degrade to cited-context replies.
# GEMINI_MODEL=gemini-2.5-flash

# ── RAG (retrieval-augmented Q&A) ────────────────────────────────────────────
# Embeddings + reranking run locally (sentence-transformers) — no key needed.
# Generation reuses GEMINI_API_KEY above.
# Embeddings: "gemini" (default) calls the API and keeps the process ~211MB;
# "local" runs sentence-transformers on-device (~463MB, but works offline).
# Switching provider changes vector dimensions — rerun `flask rag-reindex`.
# RAG_EMBEDDING_PROVIDER=gemini
# RAG_GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# RAG_SOP_DIR=../ml/rag/docs
# RAG_CHROMA_DIR=../ml/rag/chroma
# RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# RAG_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# RAG_TOP_K=6
# Off by default — it is the only remaining reason to load torch, and scored
# no better than splitting the context budget between the two indexes.
# RAG_RERANK_ENABLED=false
# Loads both local models at startup (~11s, in a background thread) so the
# first question doesn't pay for it. Turn off to save ~200MB per process where
# RAG is used rarely.
# RAG_WARM_ON_BOOT=true

# ── ML ────────────────────────────────────────────────────────────────────────
ML_MODELS_DIR=../ml/models
# Decision threshold: probability >= this → GO. Default 0.5.
GONOGO_THRESHOLD=0.5

# ── CORS ──────────────────────────────────────────────────────────────────────
# Development: allow all; production: restrict to your Vercel URL.
CORS_ORIGINS=http://localhost:5173
# CORS_ORIGINS=https://lastmeter-ai.vercel.app
