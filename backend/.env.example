# ── Flask ─────────────────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_APP=run.py

# NEVER commit real values — copy this file to .env and fill in secrets.

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=replace-with-64-char-random-string
JWT_SECRET_KEY=replace-with-different-64-char-random-string

# ── Database ──────────────────────────────────────────────────────────────────
# Development (SQLite — local file)
DATABASE_URL=sqlite:///lastmeter_dev.db
# Production (PostgreSQL on Render/Railway — uncomment and fill in)
# DATABASE_URL=postgresql://user:password@host:5432/lastmeter_prod

# ── External APIs ─────────────────────────────────────────────────────────────
OPENWEATHER_API_KEY=your_openweather_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
TOMTOM_API_KEY=your_tomtom_api_key_here

# ── ML ────────────────────────────────────────────────────────────────────────
ML_MODELS_DIR=../ml/models
# Decision threshold: probability >= this → GO. Default 0.5.
GONOGO_THRESHOLD=0.5

# ── CORS ──────────────────────────────────────────────────────────────────────
# Development: allow all; production: restrict to your Vercel URL.
CORS_ORIGINS=http://localhost:5173
# CORS_ORIGINS=https://lastmeter-ai.vercel.app
